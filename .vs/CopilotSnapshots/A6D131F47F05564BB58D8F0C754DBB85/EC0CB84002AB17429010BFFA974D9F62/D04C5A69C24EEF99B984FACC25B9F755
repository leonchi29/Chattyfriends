  String _generateGroupCode() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    final rng = DateTime.now().microsecondsSinceEpoch;
    return List.generate(6, (i) => chars[(rng ~/ (i + 1)) % chars.length]).join();
  }

  Future<void> _createGroup(String name) async {
    try {
      final code = _generateGroupCode();
      final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/groups');
      final response = await http.post(
        uri,
        headers: {..._headers, 'Prefer': 'return=representation'},
        body: jsonEncode({
          'name': name,
          'code': code,
          'created_by': _userId,
        }),
      );
      final data = jsonDecode(response.body);
      if (data is! List || data.isEmpty) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('No se pudo crear el grupo.')),
        );
        return;
      }
      final groupId = data.first['id'].toString();

      final memberUri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/group_members');
      await http.post(
        memberUri,
        headers: {..._headers, 'Prefer': 'return=minimal'},
        body: jsonEncode({'group_id': groupId, 'user_id': _userId}),
      );

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Grupo "$name" creado. Codigo: $code')),
      );
      await _loadSidebar();
    } catch (e) {
      debugPrint('Error creating group: $e');
    }
  }

