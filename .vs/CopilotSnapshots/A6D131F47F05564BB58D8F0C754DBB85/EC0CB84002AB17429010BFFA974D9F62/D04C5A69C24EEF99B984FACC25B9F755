  Future<void> _joinGroup(String code) async {
    try {
      final lookupUri = Uri.parse(
        '${_ChattyConfig.supabaseUrl}/rest/v1/groups'
        '?select=id,name'
        '&code=eq.$code'
        '&limit=1',
      );
      final lookupResponse = await http.get(lookupUri, headers: _headers);
      final lookupData = jsonDecode(lookupResponse.body);
      if (lookupData is! List || lookupData.isEmpty) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Grupo no encontrado.')),
        );
        return;
      }
      final groupId = lookupData.first['id'].toString();
      final groupName = lookupData.first['name']?.toString() ?? 'Grupo';

      final memberUri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/group_members');
      await http.post(
        memberUri,
        headers: {..._headers, 'Prefer': 'return=minimal'},
        body: jsonEncode({'group_id': groupId, 'user_id': _userId}),
      );

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Te uniste a "$groupName".')),
      );
      await _loadSidebar();
    } catch (e) {
      debugPrint('Error joining group: $e');
    }
