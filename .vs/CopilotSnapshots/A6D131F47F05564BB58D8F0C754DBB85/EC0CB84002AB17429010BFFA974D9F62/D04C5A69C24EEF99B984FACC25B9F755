  // ── Messages ──

  Future<void> _loadPrivateMessages() async {
    final friendId = _activeFriend?['friend_id']?.toString();
    if (friendId == null) return;

    if (_messages.isEmpty) setState(() => _loadingMessages = true);
    try {
      final uri = Uri.parse(
        '${_ChattyConfig.supabaseUrl}/rest/v1/messages'
        '?select=*'
        '&or=(and(sender_id.eq.$_userId,receiver_id.eq.$friendId),and(sender_id.eq.$friendId,receiver_id.eq.$_userId))'
        '&order=created_at.asc',
      );

      final response = await http.get(uri, headers: _headers);
      if (response.statusCode != 200) {
        debugPrint('Private messages error ${response.statusCode}: ${response.body}');
        return;
      }
      final data = jsonDecode(response.body);
      final messages = <Map<String, dynamic>>[];
      if (data is List) {
        for (final item in data) {
          if (item is Map) messages.add(Map<String, dynamic>.from(item));
        }
      }

      if (!mounted) return;
      setState(() => _messages = messages);
    } catch (e) {
      debugPrint('Error loading private messages: $e');
    } finally {
      if (mounted) setState(() => _loadingMessages = false);
    }
  }

  Future<void> _loadGroupMessages() async {
    final groupId = _activeGroup?['id']?.toString();
    if (groupId == null) return;

    if (_messages.isEmpty) setState(() => _loadingMessages = true);
    try {
      final uri = Uri.parse(
        '${_ChattyConfig.supabaseUrl}/rest/v1/group_messages'
        '?select=*,profiles(username)'
        '&group_id=eq.$groupId'
        '&order=created_at.asc',
      );

      final response = await http.get(uri, headers: _headers);
      if (response.statusCode != 200) {
        debugPrint('Group messages error ${response.statusCode}: ${response.body}');
        return;
      }
      final data = jsonDecode(response.body);
      final messages = <Map<String, dynamic>>[];
      if (data is List) {
        for (final item in data) {
          if (item is Map) messages.add(Map<String, dynamic>.from(item));
        }
      }

      if (!mounted) return;
      setState(() => _messages = messages);
    } catch (e) {
      debugPrint('Error loading group messages: $e');
    } finally {
      if (mounted) setState(() => _loadingMessages = false);
    }
  }

  Future<void> _reloadActiveConversation() async {
    if (_isGroupMode) {
      await _loadGroupMessages();
    } else if (_activeFriend != null) {
      await _loadPrivateMessages();
    }
  }

  Future<void> _sendMessage([String? overrideContent]) async {
    final text = overrideContent ?? _messageController.text.trim();
    if (text.isEmpty || !_hasSelection || _sending) return;

    setState(() => _sending = true);
    try {
      if (_isGroupMode) {
        final groupId = _activeGroup?['id']?.toString();
        if (groupId == null) return;

        final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/group_messages');
        final response = await http.post(
          uri,
          headers: {..._headers, 'Prefer': 'return=minimal'},
          body: jsonEncode({
            'group_id': groupId,
            'sender_id': _userId,
            'content': text,
          }),
        );
        debugPrint('Send group message: ${response.statusCode}');
      } else {
        final friendId = _activeFriend?['friend_id']?.toString();
        if (friendId == null) return;

        final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/messages');
        final response = await http.post(
          uri,
          headers: {..._headers, 'Prefer': 'return=minimal'},
          body: jsonEncode({
            'sender_id': _userId,
            'receiver_id': friendId,
            'content': text,
          }),
        );
        debugPrint('Send private message: ${response.statusCode}');
      }

      if (overrideContent == null) _messageController.clear();
      await _reloadActiveConversation();
    } catch (e) {
      debugPrint('Error sending message: $e');
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('No se pudo enviar el mensaje.')),
      );
    } finally {
      if (mounted) setState(() => _sending = false);
    }
  }

  // ── File upload ──

  Future<void> _pickAndSendFile() async {
    final result = await FilePicker.platform.pickFiles(withData: true);
    if (result == null || result.files.isEmpty) return;

    final file = result.files.first;
    if (file.bytes == null || file.name.isEmpty) return;

    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Subiendo ${file.name}...')),
    );

    try {
      final fileName = '${DateTime.now().millisecondsSinceEpoch}_${file.name}';
      final mimeType = lookupMimeType(file.name) ?? 'application/octet-stream';
      final parts = mimeType.split('/');

      final uploadUri = Uri.parse(
        '${_ChattyConfig.supabaseUrl}/storage/v1/object/chat-files/$fileName',
      );

      final request = http.MultipartRequest('POST', uploadUri)
        ..headers.addAll({
          'apikey': _ChattyConfig.supabaseAnon,
          'Authorization': 'Bearer ${_ChattyConfig.supabaseAnon}',
        })
        ..files.add(http.MultipartFile.fromBytes(
          '',
          file.bytes!,
          filename: fileName,
          contentType: MediaType(parts.first, parts.length > 1 ? parts[1] : 'octet-stream'),
        ));

      final uploadResponse = await request.send();

      if (uploadResponse.statusCode != 200) {
        debugPrint('Upload failed: ${uploadResponse.statusCode}');
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('No se pudo subir el archivo.')),
        );
        return;
      }

      final publicUrl =
          '${_ChattyConfig.supabaseUrl}/storage/v1/object/public/chat-files/$fileName';

      await _sendMessage('[Archivo: ${file.name}]\n$publicUrl');

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('${file.name} enviado.')),
      );
    } catch (e) {
      debugPrint('Error uploading file: $e');
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Error al subir archivo.')),
      );
    }
  }

  // ── Call ──

  Future<void> _startCall() async {
    if (!_hasSelection) return;

    final targetName = _isGroupMode
        ? (_activeGroup?['name']?.toString() ?? 'Grupo')
        : (_activeFriend?['profiles']?['username']?.toString() ?? 'Usuario');

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Iniciar llamada'),
        content: Text('Llamar a $targetName?'),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx, false), child: const Text('Cancelar')),
          FilledButton(onPressed: () => Navigator.pop(ctx, true), child: const Text('Llamar')),
        ],
      ),
    );

    if (confirmed != true) return;

    if (_isGroupMode) {
      final groupId = _activeGroup?['id']?.toString();
      if (groupId == null) return;

      try {
        final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/group_calls');
        await http.post(
          uri,
          headers: {..._headers, 'Prefer': 'return=minimal'},
          body: jsonEncode({
            'group_id': groupId,
            'caller_id': _userId,
            'caller_name': _username,
            'active': true,
          }),
        );
        await _sendMessage('[Llamada grupal iniciada]');
      } catch (e) {
        debugPrint('Error starting group call: $e');
      }
    } else {
      final friendId = _activeFriend?['friend_id']?.toString();
      if (friendId == null) return;
      await _sendMessage('[Llamada a $targetName]');
    }

    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Llamada a $targetName senalizada.')),
    );
  }

