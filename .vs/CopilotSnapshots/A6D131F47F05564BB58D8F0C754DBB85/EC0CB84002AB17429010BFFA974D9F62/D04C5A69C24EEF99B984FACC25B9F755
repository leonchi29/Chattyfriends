class ChatShellPage extends StatefulWidget {
  const ChatShellPage({
    super.key,
    required this.userProfile,
  });

  final Map<String, dynamic> userProfile;

  @override
  State<ChatShellPage> createState() => _ChatShellPageState();
}

class _ChatShellPageState extends State<ChatShellPage> {
  final _messageController = TextEditingController();
  Timer? _pollTimer;

  List<Map<String, dynamic>> _friends = const [];
  List<Map<String, dynamic>> _groups = const [];
  List<Map<String, dynamic>> _messages = const [];

  Map<String, dynamic>? _activeFriend;
  Map<String, dynamic>? _activeGroup;

  bool _loadingSidebar = true;
  bool _loadingMessages = false;
  bool _sending = false;

  bool get _isGroupMode => _activeGroup != null;
  bool get _hasSelection => _activeFriend != null || _activeGroup != null;

  String get _userId => widget.userProfile['id'].toString();
  String get _username => widget.userProfile['username']?.toString() ?? '';

  Map<String, String> get _headers => {
        'apikey': _ChattyConfig.supabaseAnon,
        'Authorization': 'Bearer ${_ChattyConfig.supabaseAnon}',
        'Accept': 'application/json',
        'Content-Type': 'application/json',
      };

  @override
  void initState() {
    super.initState();
    _loadSidebar();
    _pollTimer = Timer.periodic(const Duration(seconds: 3), (_) {
      if (_hasSelection) _reloadActiveConversation();
    });
  }

  @override
  void dispose() {
    _pollTimer?.cancel();
    _messageController.dispose();
    super.dispose();
  }

  // ── Sidebar data ──

  Future<void> _loadSidebar() async {
    setState(() => _loadingSidebar = true);
    try {
      final friendsUri = Uri.parse(
        '${_ChattyConfig.supabaseUrl}/rest/v1/friends'
        '?select=friend_id,profiles!friends_friend_id_fkey(id,username,avatar_url)'
        '&user_id=eq.$_userId',
      );
      final groupsUri = Uri.parse(
        '${_ChattyConfig.supabaseUrl}/rest/v1/group_members'
        '?select=group_id,groups(id,name,code)'
        '&user_id=eq.$_userId',
      );

      final responses = await Future.wait([
        http.get(friendsUri, headers: _headers),
        http.get(groupsUri, headers: _headers),
      ]);

      final friendsData = jsonDecode(responses[0].body);
      final groupsData = jsonDecode(responses[1].body);

      final friends = <Map<String, dynamic>>[];
      if (friendsData is List) {
        for (final item in friendsData) {
          if (item is Map) friends.add(Map<String, dynamic>.from(item));
        }
      }

      final groups = <Map<String, dynamic>>[];
      if (groupsData is List) {
        for (final item in groupsData) {
          if (item is Map) groups.add(Map<String, dynamic>.from(item));
        }
      }

      if (!mounted) return;
      setState(() {
        _friends = friends;
        _groups = groups;
      });
    } catch (e) {
      debugPrint('Error loading sidebar: $e');
    } finally {
      if (mounted) setState(() => _loadingSidebar = false);
    }
  }

  // ── Add friend ──

  Future<void> _showAddFriendDialog() async {
    final controller = TextEditingController();
    final username = await showDialog<String>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Agregar amigo'),
        content: TextField(
          controller: controller,
          autofocus: true,
          decoration: const InputDecoration(hintText: 'Nombre de usuario'),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancelar')),
          FilledButton(
            onPressed: () => Navigator.pop(ctx, controller.text.trim()),
            child: const Text('Agregar'),
          ),
        ],
      ),
    );
    controller.dispose();
    if (username == null || username.isEmpty) return;
    await _addFriend(username);
  }

  Future<void> _addFriend(String friendUsername) async {
    try {
      final lookupUri = Uri.parse(
        '${_ChattyConfig.supabaseUrl}/rest/v1/profiles'
        '?select=id'
        '&username=eq.$friendUsername'
        '&limit=1',
      );
      final lookupResponse = await http.get(lookupUri, headers: _headers);
      final lookupData = jsonDecode(lookupResponse.body);
      if (lookupData is! List || lookupData.isEmpty) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Usuario no encontrado.')),
        );
        return;
      }
      final friendId = lookupData.first['id'].toString();
      if (friendId == _userId) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('No puedes agregarte a ti mismo.')),
