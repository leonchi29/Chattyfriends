  // --- LLAMADAS DE VOZ (WebRTC) ---
  var callPeer = null, localStream = null, callChannel = null;
  var callState = 'idle'; // idle | calling | ringing | active
  var callTimerInterval = null, callSeconds = 0;
  var isMuted = false;
  var pendingOffer = null, pendingCallerId = null, pendingCallerName = null;
  var iceCandidateQueue = [];
  var remoteAudios = {};
  var callSendCh = null, callSendTarget = null, callSendReady = false, callSendQueue = [];
  var pendingGroupCallInvite = null;

  var ICE_SERVERS = [
    { urls: 'stun:stun.l.google.com:19302' },
    { urls: 'stun:stun1.l.google.com:19302' }
  ];

  function setMutedLine(show) {
    document.getElementById('call-muted-line').style.display = show ? 'block' : 'none';
  }

  function playRemoteAudio(key, stream) {
    var audio = remoteAudios[key] || new Audio();
    audio.autoplay = true;
    audio.playsInline = true;
    audio.muted = false;
    audio.volume = 1;
    audio.srcObject = stream;
    remoteAudios[key] = audio;
    audio.play().catch(function() {});
  }

  function clearRemoteAudio(key) {
    var audio = remoteAudios[key];
    if (!audio) return;
    audio.pause();
    audio.srcObject = null;
    delete remoteAudios[key];
  }

  document.addEventListener('click', function() {
    Object.keys(remoteAudios).forEach(function(key) {
      var a = remoteAudios[key];
      if (a && a.srcObject) a.play().catch(function() {});
    });
  });

  function subscribeCallChannel() {
    if (callChannel) return;
    callChannel = sb.channel('calls-' + currentUser.id, { config: { broadcast: { self: false } } });
    callChannel.on('broadcast', { event: 'call-signal' }, async (msg) => {
      var d = msg.payload;
      if (!d) return;
      if (d.type === 'offer') {
        if (callState !== 'idle' || groupCallActive || pendingGroupCallInvite) {
          sendCallSignal(d.fromId, { type: 'busy' });
          return;
        }
        pendingOffer = d.offer;
        pendingCallerId = d.fromId;
        pendingCallerName = d.callerName;
        iceCandidateQueue = [];
        if (d.groupId) {
          showIncomingGroupCall(d.groupId, d.groupName || 'Grupo', d.callerName);
        } else {
          showIncomingCall(d.callerName);
        }
      } else if (d.type === 'answer') {
        if (callPeer && callPeer.signalingState !== 'stable') {
          await callPeer.setRemoteDescription(new RTCSessionDescription(d.answer));
          iceCandidateQueue.forEach(function(c) { callPeer.addIceCandidate(new RTCIceCandidate(c)); });
          iceCandidateQueue = [];
          setCallActive();
        }
      } else if (d.type === 'ice-candidate') {
        if (callPeer && callPeer.remoteDescription) {
          callPeer.addIceCandidate(new RTCIceCandidate(d.candidate));
        } else {
          iceCandidateQueue.push(d.candidate);
        }
      } else if (d.type === 'end' || d.type === 'busy' || d.type === 'reject') {
        if (d.type === 'busy') toast('El usuario está en otra llamada');
        if (d.type === 'reject') toast('Llamada rechazada');
        cleanupCall();
      }
    });
    callChannel.subscribe();
  }

  function sendCallSignal(targetUserId, payload) {
    var msg = {
      type: 'broadcast',
      event: 'call-signal',
      payload: Object.assign({}, payload, { fromId: currentUser.id })
    };
    if (callSendCh && callSendTarget === targetUserId) {
      if (callSendReady) { callSendCh.send(msg); }
      else { callSendQueue.push(msg); }
      return;
    }
    if (callSendCh) { sb.removeChannel(callSendCh); }
    callSendTarget = targetUserId;
    callSendReady = false;
    callSendQueue = [msg];
    callSendCh = sb.channel('calls-' + targetUserId);
    callSendCh.subscribe(function(status) {
      if (status === 'SUBSCRIBED') {
        callSendReady = true;
        callSendQueue.forEach(function(m) { callSendCh.send(m); });
        callSendQueue = [];
      }
    });
  }

  async function startCall() {
    if (chatMode === 'group' && activeGroup) return startGroupCall();
    if (!activeFriend || chatMode !== 'private') return toast('Selecciona un chat privado');
    if (activeFriend.id === BOT_ID) return toast('No puedes llamar al bot');
    if (callState !== 'idle') return toast('Ya hay una llamada en curso');

    try {
      localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
    } catch(e) {
      return toast('Se necesita permiso de micr\u00F3fono para llamar');
    }

    callState = 'calling';
    isMuted = false;
    showOutgoingCall(activeFriend.name);

    callPeer = new RTCPeerConnection({ iceServers: ICE_SERVERS });
    localStream.getTracks().forEach(function(t) { callPeer.addTrack(t, localStream); });

    callPeer.onicecandidate = function(e) {
      if (e.candidate) {
        sendCallSignal(activeFriend.id, { type: 'ice-candidate', candidate: e.candidate.toJSON() });
      }
    };

    callPeer.ontrack = function(e) {
      playRemoteAudio('private', e.streams[0]);
    };

    callPeer.onconnectionstatechange = function() {
      if (callPeer.connectionState === 'disconnected' || callPeer.connectionState === 'failed') {
        endCall();
      }
    };

    var offer = await callPeer.createOffer();
    await callPeer.setLocalDescription(offer);

    sendCallSignal(activeFriend.id, {
      type: 'offer',
      offer: callPeer.localDescription.toJSON(),
      callerName: currentUser.username
    });

    setTimeout(function() {
      if (callState === 'calling') {
        toast('No hubo respuesta');
        endCall();
      }
    }, 30000);
  }

  async function answerCall() {
    if (pendingGroupCallInvite) {
      var inv = pendingGroupCallInvite;
      pendingGroupCallInvite = null;
      document.getElementById('call-modal').style.display = 'none';
      document.getElementById('call-avatar').style.background = '#1b66c9';
      var { data: grp } = await sb.from('groups').select('*').eq('id', inv.groupId).maybeSingle();
      if (grp) {
        await openGroupChat(grp.id, grp.name, grp.code);
        await joinGroupCall();
      }
      return;
    }
    if (!pendingOffer) return;

    try {
      localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
    } catch(e) {
      sendCallSignal(pendingCallerId, { type: 'reject' });
      cleanupCall();
      return toast('Se necesita permiso de micr\u00F3fono para contestar');
    }

    callState = 'active';
    isMuted = false;

    callPeer = new RTCPeerConnection({ iceServers: ICE_SERVERS });
    localStream.getTracks().forEach(function(t) { callPeer.addTrack(t, localStream); });

    callPeer.onicecandidate = function(e) {
      if (e.candidate) {
        sendCallSignal(pendingCallerId, { type: 'ice-candidate', candidate: e.candidate.toJSON() });
      }
    };

    callPeer.ontrack = function(e) {
      playRemoteAudio('private', e.streams[0]);
    };

    callPeer.onconnectionstatechange = function() {
      if (callPeer.connectionState === 'disconnected' || callPeer.connectionState === 'failed') {
        endCall();
      }
    };

    await callPeer.setRemoteDescription(new RTCSessionDescription(pendingOffer));
    iceCandidateQueue.forEach(function(c) { callPeer.addIceCandidate(new RTCIceCandidate(c)); });
    iceCandidateQueue = [];

    var answer = await callPeer.createAnswer();
    await callPeer.setLocalDescription(answer);

    sendCallSignal(pendingCallerId, { type: 'answer', answer: callPeer.localDescription.toJSON() });
    setCallActive();
  }

  function endCall() {
    if (pendingGroupCallInvite) {
      var endedPayload = nativeIncomingCall;
      pendingGroupCallInvite = null;
      nativeIncomingCall = null;
      document.getElementById('call-modal').style.display = 'none';
      document.getElementById('call-avatar').style.background = '#1b66c9';
      if (endedPayload) notifyNative('callEnded', endedPayload);
      return;
    }
    if (groupCallActive) return leaveGroupCall();
    var targetId = null;
    if (callState === 'calling' && activeFriend) targetId = activeFriend.id;
    if (callState === 'ringing' && pendingCallerId) targetId = pendingCallerId;
    if (callState === 'active') targetId = activeFriend ? activeFriend.id : pendingCallerId;
    if (targetId) sendCallSignal(targetId, { type: 'end' });
    cleanupCall();
  }

  function cleanupCall() {
    var endedPayload = nativeIncomingCall;
    if (callPeer) {
      clearRemoteAudio('private');
      callPeer.close();
      callPeer = null;
    }
    if (localStream) {
      localStream.getTracks().forEach(function(t) { t.stop(); });
      localStream = null;
    }
    if (callSendCh) { sb.removeChannel(callSendCh); callSendCh = null; }
    callSendTarget = null; callSendReady = false; callSendQueue = [];
    callState = 'idle';
    pendingOffer = null;
    pendingCallerId = null;
    pendingCallerName = null;
    pendingGroupCallInvite = null;
    iceCandidateQueue = [];
    isMuted = false;
    if (callTimerInterval) { clearInterval(callTimerInterval); callTimerInterval = null; }
    callSeconds = 0;
    document.getElementById('call-avatar').style.background = '#1b66c9';
    setMutedLine(false);
    document.getElementById('call-modal').style.display = 'none';
    nativeIncomingCall = null;
    if (endedPayload) notifyNative('callEnded', endedPayload);
  }

  function showOutgoingCall(name) {
    document.getElementById('call-avatar').textContent = name[0].toUpperCase();
    document.getElementById('call-name').textContent = name;
    document.getElementById('call-status').textContent = 'Llamando...';
    document.getElementById('call-timer').style.display = 'none';
    document.getElementById('call-accept-btn').style.display = 'none';
    document.getElementById('call-mute-btn').style.display = 'none';
    setMutedLine(false);
    document.getElementById('call-modal').style.display = 'flex';
  }

  function showIncomingCall(name) {
    callState = 'ringing';
    document.getElementById('call-avatar').textContent = name[0].toUpperCase();
    document.getElementById('call-name').textContent = name;
    document.getElementById('call-status').textContent = 'Llamada entrante...';
    document.getElementById('call-timer').style.display = 'none';
    document.getElementById('call-accept-btn').style.display = 'flex';
    document.getElementById('call-mute-btn').style.display = 'none';
    setMutedLine(false);
    document.getElementById('call-modal').style.display = 'flex';
    var payload = {
      callId: 'private-' + pendingCallerId + '-' + Date.now(),
      callType: 'private',
      callerId: pendingCallerId,
      callerName: name,
      handle: name
    };
    notifyNativeIncomingCall(payload);
    showDesktopNotification('Llamada de ' + name, 'Te está llamando...', 'call-incoming');
  }

  function showIncomingGroupCall(groupId, groupName, callerName) {
    pendingGroupCallInvite = { groupId: groupId, groupName: groupName, callerName: callerName };
    document.getElementById('call-avatar').textContent = '#';
    document.getElementById('call-avatar').style.background = '#4caf50';
    document.getElementById('call-name').textContent = groupName;
    document.getElementById('call-status').textContent = callerName + ' inició una llamada grupal';
    document.getElementById('call-timer').style.display = 'none';
    document.getElementById('call-accept-btn').style.display = 'flex';
    document.getElementById('call-mute-btn').style.display = 'none';
    setMutedLine(false);
    document.getElementById('call-modal').style.display = 'flex';
    var payload = {
      callId: 'group-' + groupId + '-' + Date.now(),
      callType: 'group',
      groupId: groupId,
      groupName: groupName,
      callerName: callerName,
      handle: groupName
    };
    notifyNativeIncomingCall(payload);
    showDesktopNotification('Llamada grupal ' + groupName, callerName + ' inició una llamada grupal', 'gcall-incoming');
  }

  function setCallActive() {
    callState = 'active';
    document.getElementById('call-status').textContent = 'En llamada';
    document.getElementById('call-accept-btn').style.display = 'none';
    document.getElementById('call-mute-btn').style.display = 'flex';
    document.getElementById('call-timer').style.display = 'block';
    setMutedLine(false);
    callSeconds = 0;
    if (nativeIncomingCall) notifyNative('callConnected', nativeIncomingCall);
    callTimerInterval = setInterval(function() {
      callSeconds++;
      var m = String(Math.floor(callSeconds / 60)).padStart(2, '0');
      var s = String(callSeconds % 60).padStart(2, '0');
      document.getElementById('call-timer').textContent = m + ':' + s;
    }, 1000);
  }

  function toggleMute() {
    if (groupCallActive) return toggleGroupMute();
    if (!localStream) return;
    isMuted = !isMuted;
    localStream.getAudioTracks().forEach(function(t) { t.enabled = !isMuted; });
    var btn = document.getElementById('call-mute-btn');
    btn.className = 'call-btn call-btn-mute' + (isMuted ? ' muted' : '');
    btn.title = isMuted ? 'Activar micr\u00F3fono' : 'Silenciar';
    setMutedLine(isMuted);
  }
</script>

