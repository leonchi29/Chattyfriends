  });

  final Map<String, dynamic> userProfile;

  @override
  State<ChatShellPage> createState() => _ChatShellPageState();
}

class _ChatShellPageState extends State<ChatShellPage> {
  InAppWebViewController? _controller;
  bool _bootstrapped = false;
  bool _ready = true;
  String _statusText = 'Entrando...';

  WebUri get _initialUrl =>
      kIsWeb ? WebUri('chat.html') : WebUri('http://localhost:8080/assets/chat.html');

  @override
  void initState() {
    super.initState();
    _requestRequiredPermissions();
  }

  @override
  void dispose() {
    _nativePhoneBridge.detachController();
    super.dispose();
  }

  Future<void> _requestRequiredPermissions() async {
    if (kIsWeb) return;
    await Permission.notification.request();
    await Permission.microphone.request();
    if (defaultTargetPlatform == TargetPlatform.android) {
      try {
        await FlutterCallkitIncoming.requestFullIntentPermission();
      } catch (_) {}
    }
  }

  Future<void> _bootstrap() async {
    if (_bootstrapped || _controller == null) return;

    final configJson = jsonEncode({
      'managedByFlutter': true,
      'skipVersionPopup': true,
      'mobileShell': true,
    });
    final profileJson = jsonEncode(widget.userProfile);

    final ready = await _controller!.evaluateJavascript(
      source:
          '(function(){return !!(window.ChattyNative && window.ChattyNative.loginWithUser);})()',
    );

    final isReady = ready == true || ready == 'true' || ready == 1;
    if (!isReady) return;

    _bootstrapped = true;
    setState(() => _statusText = 'Entrando...');

    await _controller!.evaluateJavascript(
      source:
          'window.ChattyNative.configure($configJson);window.ChattyNative.loginWithUser($profileJson);',
    );
  }

  Map<String, dynamic> _payloadFromArgs(List<dynamic> args) {
    if (args.isEmpty || args.first is! Map) return <String, dynamic>{};
    return Map<String, dynamic>.from(args.first as Map);
  }

  void _handleAuthResult(List<dynamic> args) {
    final payload = _payloadFromArgs(args);
    final success = payload['success'] == true;

    if (success) {
      return;
    }

    final message = payload['message']?.toString() ?? 'No se pudo iniciar sesion.';
    if (!mounted) return;

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(message)),
    );
    Navigator.of(context).pushAndRemoveUntil(
      MaterialPageRoute<void>(builder: (_) => const NativeLoginPage()),
      (route) => false,
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Stack(
        children: [
          InAppWebView(
            initialUrlRequest: URLRequest(url: _initialUrl),
            initialSettings: InAppWebViewSettings(
              javaScriptEnabled: true,
              mediaPlaybackRequiresUserGesture: false,
              allowsInlineMediaPlayback: true,
              domStorageEnabled: true,
              databaseEnabled: true,
              javaScriptCanOpenWindowsAutomatically: true,
              supportMultipleWindows: true,
              allowFileAccess: true,
              allowContentAccess: true,
              mixedContentMode: MixedContentMode.MIXED_CONTENT_ALWAYS_ALLOW,
              useWideViewPort: false,
              transparentBackground: true,
            ),
            onWebViewCreated: (controller) {
              _controller = controller;
              _nativePhoneBridge.attachController(controller);
              _bootstrap();
              controller.addJavaScriptHandler(
                handlerName: 'authResult',
                callback: (args) {
                  _handleAuthResult(args);
                  return null;
                },
              );
              controller.addJavaScriptHandler(
                handlerName: 'appReady',
                callback: (args) {
                  _nativePhoneBridge.onWebAppReady();
                  if (mounted) {
                    setState(() => _ready = true);
                  }
                  return null;
                },
              );
              controller.addJavaScriptHandler(
                handlerName: 'incomingMessage',
                callback: (args) async {
                  await _nativePhoneBridge.showIncomingMessage(_payloadFromArgs(args));
                  return null;
                },
              );
              controller.addJavaScriptHandler(
                handlerName: 'incomingCall',
                callback: (args) async {
                  await _nativePhoneBridge.showIncomingCall(_payloadFromArgs(args));
                  return null;
                },
              );
              controller.addJavaScriptHandler(
                handlerName: 'callConnected',
                callback: (args) async {
                  await _nativePhoneBridge.markCallConnected(_payloadFromArgs(args));
                  return null;
                },
              );
              controller.addJavaScriptHandler(
                handlerName: 'callEnded',
                callback: (args) async {
                  await _nativePhoneBridge.endCall(_payloadFromArgs(args));
                  return null;
                },
              );
            },
            onLoadStart: (controller, url) async {
              if (mounted && !_ready) {
                setState(() => _ready = true);
              }
              await _bootstrap();
            },
            onProgressChanged: (controller, progress) async {
              if (mounted && !_ready && progress >= 5) {
                setState(() => _ready = true);
              }
              if (progress >= 20) {
                await _bootstrap();
              }
            },
            onLoadStop: (controller, url) async {
              if (mounted && !_ready) {
                setState(() => _ready = true);
              }
              await _bootstrap();
            },
            onPermissionRequest: (controller, request) async {
              return PermissionResponse(
                resources: request.resources,
                action: PermissionResponseAction.GRANT,
              );
            },
            onConsoleMessage: (controller, message) {
              debugPrint('WebView: ${message.message}');
            },
          ),
          if (!_ready)
            ColoredBox(
              color: const Color(0xFFF2F7F5),
              child: Center(
                child: Padding(
                  padding: const EdgeInsets.all(24),
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      const SizedBox(
                        width: 42,
                        height: 42,
                        child: CircularProgressIndicator(strokeWidth: 3),
                      ),
                      const SizedBox(height: 18),
                      Text(
                        _statusText,
                        textAlign: TextAlign.center,
                        style: Theme.of(context).textTheme.titleMedium?.copyWith(
                          color: const Color(0xFF111B21),
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
        ],
      ),
    );
  }
}

