@pragma('vm:entry-point')
Future<void> _firebaseMessagingBackgroundHandler(RemoteMessage message) async {
  await _nativePhoneBridge.ensureFirebaseInitialized();
}

class _NativePhoneBridge {
  final FlutterLocalNotificationsPlugin _notifications = FlutterLocalNotificationsPlugin();
  static const AndroidNotificationChannel _messageChannel = AndroidNotificationChannel(
    'chattyfriends_messages',
    'Mensajes ChattyFriends',
    description: 'Notificaciones de mensajes entrantes',
    importance: Importance.max,
  );

  StreamSubscription<CallEvent?>? _callkitSubscription;
  StreamSubscription<String>? _tokenRefreshSubscription;
  InAppWebViewController? _controller;
  final List<String> _pendingScripts = [];
  String? _activeCallId;
  String? _pushToken;
  bool _firebaseReady = false;
  bool _webReady = false;
  Map<String, dynamic>? _activeCallPayload;

  Future<void> initialize() async {
    if (kIsWeb) return;

    const settings = InitializationSettings(
      android: AndroidInitializationSettings('@mipmap/ic_launcher'),
      iOS: DarwinInitializationSettings(),
    );

    await _notifications.initialize(
      settings,
      onDidReceiveNotificationResponse: (response) {
        final rawPayload = response.payload;
        if (rawPayload == null || rawPayload.isEmpty) return;
        try {
          final payload = Map<String, dynamic>.from(jsonDecode(rawPayload) as Map);
          _openConversation(payload);
        } catch (_) {}
      },
    );

    await _notifications
        .resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>()
        ?.createNotificationChannel(_messageChannel);

    _callkitSubscription ??= FlutterCallkitIncoming.onEvent.listen(_handleCallKitEvent);
    await _initializeFirebaseMessaging();
  }

  Future<bool> ensureFirebaseInitialized() async {
    if (kIsWeb) return false;
    if (_firebaseReady && Firebase.apps.isNotEmpty) return true;

    try {
      if (Firebase.apps.isEmpty) {
        await Firebase.initializeApp();
      }
      _firebaseReady = true;
      return true;
    } catch (error) {
      debugPrint('Firebase init skipped: $error');
      _firebaseReady = false;
      return false;
    }
  }

  Future<void> _initializeFirebaseMessaging() async {
    if (!await ensureFirebaseInitialized()) return;

    final messaging = FirebaseMessaging.instance;
    await messaging.setAutoInitEnabled(true);
    await messaging.requestPermission(
      alert: true,
      badge: true,
      sound: true,
      provisional: false,
    );

    final token = await messaging.getToken();
    _setPushToken(token);

    _tokenRefreshSubscription ??= messaging.onTokenRefresh.listen(_setPushToken);

    FirebaseMessaging.onMessage.listen((message) async {
      await handleRemoteMessage(message, fromTap: false);
    });

    FirebaseMessaging.onMessageOpenedApp.listen((message) async {
      await handleRemoteMessage(message, fromTap: true);
    });

    final initialMessage = await messaging.getInitialMessage();
    if (initialMessage != null) {
      await handleRemoteMessage(initialMessage, fromTap: true);
    }
  }

  Future<void> handleRemoteMessage(
    RemoteMessage message, {
    required bool fromTap,
  }) async {
    final payload = _payloadFromRemoteMessage(message);
    if (payload.isEmpty) return;

    if (fromTap) {
      await _openConversation(payload);
      return;
    }

    if ((payload['type']?.toString() == 'call') || payload['callType'] != null) {
      await showIncomingCall(payload);
      return;
    }

    await showIncomingMessage(payload);
  }

  Map<String, dynamic> _payloadFromRemoteMessage(RemoteMessage message) {
    final data = Map<String, dynamic>.from(message.data);
    if (data.isEmpty && message.notification == null) {
      return <String, dynamic>{};
    }

    final type = data['type']?.toString() ?? data['notificationType']?.toString() ?? 'message';
    final title = message.notification?.title ??
        data['title']?.toString() ??
        data['senderName']?.toString() ??
        data['groupName']?.toString() ??
        'ChattyFriends';
    final body = message.notification?.body ??
        data['body']?.toString() ??
        data['message']?.toString() ??
        'Nueva actividad';

    return <String, dynamic>{
      ...data,
      'type': type,
      'title': title,
      'body': body,
      if (data['chatType'] == null && data['groupId'] != null) 'chatType': 'group',
      if (data['chatType'] == null && data['senderId'] != null) 'chatType': 'private',
      if (data['callType'] == null && type == 'call') 'callType': data['groupId'] != null ? 'group' : 'private',
      if (data['callerName'] == null && data['senderName'] != null) 'callerName': data['senderName'],
      if (data['callerId'] == null && data['senderId'] != null) 'callerId': data['senderId'],
      if (data['handle'] == null) 'handle': data['groupName'] ?? data['senderName'] ?? title,
      if (data['callId'] == null) 'callId': message.messageId ?? DateTime.now().microsecondsSinceEpoch.toString(),
      if (data['id'] == null) 'id': message.messageId ?? DateTime.now().microsecondsSinceEpoch.toString(),
    };
  }

  void attachController(InAppWebViewController controller) {
    _controller = controller;
    _webReady = false;
  }

  void detachController() {
    _controller = null;
    _webReady = false;
  }

  void onWebAppReady() {
    _webReady = true;
    _flushPendingScripts();
    _syncPushTokenToWeb();
  }

  Future<void> showIncomingMessage(Map<String, dynamic> payload) async {
    if (kIsWeb) return;

    final title = payload['title']?.toString() ?? 'ChattyFriends';
    final body = payload['body']?.toString() ?? 'Nuevo mensaje';

    await _notifications.show(
      Object.hash(title, body, payload['id']),
      title,
      body,
      const NotificationDetails(
        android: AndroidNotificationDetails(
          'chattyfriends_messages',
          'Mensajes ChattyFriends',
          channelDescription: 'Notificaciones de mensajes entrantes',
          importance: Importance.max,
          priority: Priority.high,
        ),
        iOS: DarwinNotificationDetails(
          presentAlert: true,
          presentBadge: true,
          presentSound: true,
        ),
      ),
      payload: jsonEncode(payload),
    );
  }

  Future<void> showIncomingCall(Map<String, dynamic> payload) async {
    if (kIsWeb) return;

    final callPayload = Map<String, dynamic>.from(payload);
    callPayload.putIfAbsent(
      'callId',
      () => DateTime.now().microsecondsSinceEpoch.toString(),
    );

    _activeCallId = callPayload['callId']?.toString();
    _activeCallPayload = callPayload;

    final params = CallKitParams(
      id: _activeCallId,
      nameCaller: callPayload['callerName']?.toString() ?? callPayload['title']?.toString() ?? 'ChattyFriends',
      appName: 'ChattyFriends',
      handle: callPayload['handle']?.toString() ?? 'Llamada entrante',
      type: 0,
      duration: 30000,
      textAccept: 'Aceptar',
      textDecline: 'Rechazar',
      extra: callPayload,
      missedCallNotification: const NotificationParams(
        showNotification: true,
        isShowCallback: false,
        subtitle: 'Llamada perdida',
        callbackText: 'Abrir',
      ),
      android: const AndroidParams(
        isCustomNotification: false,
        isShowLogo: false,
        isShowCallID: false,
        isShowFullLockedScreen: true,
        ringtonePath: 'system_ringtone_default',
        incomingCallNotificationChannelName: 'Llamadas ChattyFriends',
        missedCallNotificationChannelName: 'Llamadas perdidas ChattyFriends',
        backgroundColor: '#128C7E',
        actionColor: '#25D366',
        textColor: '#ffffff',
      ),
      ios: const IOSParams(
        iconName: 'AppIcon',
        handleType: 'generic',
        supportsVideo: false,
        maximumCallGroups: 1,
        maximumCallsPerCallGroup: 1,
        audioSessionMode: 'default',
        audioSessionActive: true,
        audioSessionPreferredSampleRate: 44100.0,
        audioSessionPreferredIOBufferDuration: 0.005,
        supportsDTMF: false,
        supportsHolding: false,
        supportsGrouping: true,
        supportsUngrouping: true,
        ringtonePath: 'system_ringtone_default',
      ),
    );

    await FlutterCallkitIncoming.showCallkitIncoming(params);
  }

  Future<void> markCallConnected(Map<String, dynamic> payload) async {
    final callId = payload['callId']?.toString() ?? _activeCallId;
    if (callId == null || callId.isEmpty) return;
    await FlutterCallkitIncoming.setCallConnected(callId);
  }

  Future<void> endCall(Map<String, dynamic> payload) async {
    final callId = payload['callId']?.toString() ?? _activeCallId;
    if (callId == null || callId.isEmpty) return;
    _activeCallId = null;
    _activeCallPayload = null;
    await FlutterCallkitIncoming.endCall(callId);
  }

  Future<void> _handleCallKitEvent(CallEvent? event) async {
    if (event == null) return;

    final currentEvent = event.event.toString();

    if (currentEvent.endsWith('actionCallAccept')) {
      final payload = _payloadFromEvent(event.body) ?? _activeCallPayload;
      if (payload != null) {
        await _runJavaScript(
          'window.ChattyNative && window.ChattyNative.answerIncomingCall(${jsonEncode(payload)});',
        );
      }
      return;
    }

    if (currentEvent.endsWith('actionCallDecline') ||
        currentEvent.endsWith('actionCallEnded') ||
        currentEvent.endsWith('actionCallTimeout')) {
      final payload = _payloadFromEvent(event.body) ?? _activeCallPayload;
      _activeCallId = null;
      _activeCallPayload = null;
      if (payload != null) {
        await _runJavaScript(
          'window.ChattyNative && window.ChattyNative.rejectIncomingCall(${jsonEncode(payload)});',
        );
      }
    }
  }

  Map<String, dynamic>? _payloadFromEvent(dynamic body) {
    if (body is! Map) return null;
    final map = Map<String, dynamic>.from(body);
    final extra = map['extra'];
    if (extra is Map) {
      return Map<String, dynamic>.from(extra);
    }
    return map;
  }

  void _setPushToken(String? token) {
    if (token == null || token.isEmpty) return;
    _pushToken = token;
    _syncPushTokenToWeb();
  }

  void _syncPushTokenToWeb() {
    if (_pushToken == null) return;
    final payload = <String, dynamic>{
      'token': _pushToken,
      'platform': defaultTargetPlatform.name,
    };
    _runJavaScript(
      'window.ChattyNative && window.ChattyNative.registerPushToken(${jsonEncode(payload)});',
    );
  }

  Future<void> _openConversation(Map<String, dynamic> payload) async {
    await _runJavaScript(
      'window.ChattyNative && window.ChattyNative.openConversation(${jsonEncode(payload)});',
    );
  }

  Future<void> _runJavaScript(String source) async {
    final controller = _controller;
    if (controller == null || !_webReady) {
      _pendingScripts.add(source);
      return;
    }
    await controller.evaluateJavascript(source: source);
  }

  void _flushPendingScripts() {
    final controller = _controller;
    if (controller == null || !_webReady || _pendingScripts.isEmpty) return;
    final scripts = List<String>.from(_pendingScripts);
    _pendingScripts.clear();
    for (final script in scripts) {
      controller.evaluateJavascript(source: script);
    }
  }
}

