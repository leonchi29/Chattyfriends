class _ChatShellPageState extends State<ChatShellPage> {
  final _messageController = TextEditingController();

  List<Map<String, dynamic>> _friends = const [];
  List<Map<String, dynamic>> _groups = const [];
  List<Map<String, dynamic>> _messages = const [];

  Map<String, dynamic>? _activeFriend;
  Map<String, dynamic>? _activeGroup;

  bool _loadingSidebar = true;
  bool _loadingMessages = false;
  bool _sending = false;

  bool get _isGroupMode => _activeGroup != null;
  bool get _hasSelection => _activeFriend != null || _activeGroup != null;

  String get _userId => widget.userProfile['id'].toString();

  Map<String, String> get _headers => {
        'apikey': _ChattyConfig.supabaseAnon,
        'Authorization': 'Bearer ${_ChattyConfig.supabaseAnon}',
        'Accept': 'application/json',
        'Content-Type': 'application/json',
      };

  @override
  void initState() {
    super.initState();
    _loadSidebar();
  }

  @override
  void dispose() {
    _messageController.dispose();
    super.dispose();
  }

  Future<void> _loadSidebar() async {
    setState(() => _loadingSidebar = true);
    try {
      final friendsUri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/friends').replace(
        queryParameters: {
          'select': 'friend_id,profiles!friends_friend_id_fkey(id,username,avatar_url)',
          'user_id': 'eq.$_userId',
        },
      );
      final groupsUri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/group_members').replace(
        queryParameters: {
          'select': 'group_id,groups(id,name,code)',
          'user_id': 'eq.$_userId',
        },
      );

      final responses = await Future.wait([
        http.get(friendsUri, headers: _headers),
        http.get(groupsUri, headers: _headers),
      ]);

      final friendsData = jsonDecode(responses[0].body);
      final groupsData = jsonDecode(responses[1].body);

      final friends = <Map<String, dynamic>>[];
      if (friendsData is List) {
        for (final item in friendsData) {
          if (item is Map) friends.add(Map<String, dynamic>.from(item));
        }
      }

      final groups = <Map<String, dynamic>>[];
      if (groupsData is List) {
        for (final item in groupsData) {
          if (item is Map) groups.add(Map<String, dynamic>.from(item));
        }
      }

      if (!mounted) return;
      setState(() {
        _friends = friends;
        _groups = groups;
      });
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('No se pudo cargar la lista de chats.')),
      );
    } finally {
      if (mounted) setState(() => _loadingSidebar = false);
    }
  }

  Future<void> _openPrivate(Map<String, dynamic> friend) async {
    setState(() {
      _activeFriend = friend;
      _activeGroup = null;
      _messages = const [];
    });
    await _loadPrivateMessages();
  }

  Future<void> _openGroup(Map<String, dynamic> groupMember) async {
    setState(() {
      _activeGroup = Map<String, dynamic>.from(groupMember['groups'] as Map);
      _activeFriend = null;
      _messages = const [];
    });
    await _loadGroupMessages();
  }

  Future<void> _loadPrivateMessages() async {
    final friendId = _activeFriend?['friend_id']?.toString();
    if (friendId == null) return;

    setState(() => _loadingMessages = true);
    try {
      final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/messages').replace(
        queryParameters: {
          'select': '*',
          'or': 'and(sender_id.eq.$_userId,receiver_id.eq.$friendId),and(sender_id.eq.$friendId,receiver_id.eq.$_userId)',
          'order': 'created_at.asc',
        },
      );

      final response = await http.get(uri, headers: _headers);
      final data = jsonDecode(response.body);
      final messages = <Map<String, dynamic>>[];
      if (data is List) {
        for (final item in data) {
          if (item is Map) messages.add(Map<String, dynamic>.from(item));
        }
      }

      if (!mounted) return;
      setState(() => _messages = messages);
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('No se pudo cargar mensajes privados.')),
      );
    } finally {
      if (mounted) setState(() => _loadingMessages = false);
    }
  }

  Future<void> _loadGroupMessages() async {
    final groupId = _activeGroup?['id']?.toString();
    if (groupId == null) return;

    setState(() => _loadingMessages = true);
    try {
      final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/group_messages').replace(
        queryParameters: {
          'select': '*,profiles(username)',
          'group_id': 'eq.$groupId',
          'order': 'created_at.asc',
        },
      );

      final response = await http.get(uri, headers: _headers);
      final data = jsonDecode(response.body);
      final messages = <Map<String, dynamic>>[];
      if (data is List) {
        for (final item in data) {
          if (item is Map) messages.add(Map<String, dynamic>.from(item));
        }
      }

      if (!mounted) return;
      setState(() => _messages = messages);
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('No se pudo cargar mensajes grupales.')),
      );
    } finally {
      if (mounted) setState(() => _loadingMessages = false);
    }
  }

  Future<void> _reloadActiveConversation() async {
    if (_isGroupMode) {
      await _loadGroupMessages();
    } else {
      await _loadPrivateMessages();
    }
  }

  Future<void> _sendMessage() async {
    final text = _messageController.text.trim();
    if (text.isEmpty || !_hasSelection || _sending) return;

    setState(() => _sending = true);
    try {
      if (_isGroupMode) {
        final groupId = _activeGroup?['id']?.toString();
        if (groupId == null) return;

        final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/group_messages');
        await http.post(
          uri,
          headers: {..._headers, 'Prefer': 'return=minimal'},
          body: jsonEncode({
            'group_id': groupId,
            'sender_id': _userId,
            'content': text,
          }),
        );
      } else {
        final friendId = _activeFriend?['friend_id']?.toString();
        if (friendId == null) return;

        final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/messages');
        await http.post(
          uri,
          headers: {..._headers, 'Prefer': 'return=minimal'},
          body: jsonEncode({
            'sender_id': _userId,
            'receiver_id': friendId,
            'content': text,
          }),
        );
      }

      _messageController.clear();
      await _reloadActiveConversation();
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('No se pudo enviar el mensaje.')),
      );
    } finally {
      if (mounted) setState(() => _sending = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final title = _isGroupMode
        ? (_activeGroup?['name']?.toString() ?? 'Grupo')
        : (_activeFriend?['profiles']?['username']?.toString() ?? 'ChattyFriends');

    return Scaffold(
      appBar: AppBar(
        title: Text(_hasSelection ? title : 'ChattyFriends'),
        actions: [
          IconButton(
            onPressed: _loadSidebar,
            icon: const Icon(Icons.refresh_rounded),
          ),
        ],
      ),
      body: LayoutBuilder(
        builder: (context, constraints) {
          final mobile = constraints.maxWidth < 900;
          if (mobile && _hasSelection) {
            return _buildConversation(mobile: true);
          }

          return Row(
            children: [
              SizedBox(
                width: mobile ? constraints.maxWidth : 340,
                child: _buildSidebar(),
              ),
              if (!mobile)
                Expanded(
                  child: _buildConversation(mobile: false),
                ),
            ],
          );
        },
      ),
    );
  }

  Widget _buildSidebar() {
    if (_loadingSidebar) {
      return const Center(child: CircularProgressIndicator());
    }

    return ListView(
      padding: const EdgeInsets.symmetric(vertical: 8),
      children: [
        const Padding(
          padding: EdgeInsets.fromLTRB(16, 8, 16, 4),
          child: Text('Privados', style: TextStyle(fontWeight: FontWeight.w700)),
        ),
        if (_friends.isEmpty)
          const Padding(
            padding: EdgeInsets.symmetric(horizontal: 16, vertical: 8),
            child: Text('Sin amigos.'),
          ),
        for (final friend in _friends)
          ListTile(
            leading: const CircleAvatar(child: Icon(Icons.person_rounded)),
            title: Text(friend['profiles']?['username']?.toString() ?? 'Usuario'),
            onTap: () => _openPrivate(friend),
          ),
        const Divider(height: 20),
        const Padding(
          padding: EdgeInsets.fromLTRB(16, 8, 16, 4),
          child: Text('Grupos', style: TextStyle(fontWeight: FontWeight.w700)),
        ),
        if (_groups.isEmpty)
          const Padding(
            padding: EdgeInsets.symmetric(horizontal: 16, vertical: 8),
            child: Text('Sin grupos.'),
          ),
        for (final groupMember in _groups)
          ListTile(
            leading: const CircleAvatar(child: Icon(Icons.group_rounded)),
            title: Text(groupMember['groups']?['name']?.toString() ?? 'Grupo'),
            subtitle: Text(groupMember['groups']?['code']?.toString() ?? ''),
            onTap: () => _openGroup(groupMember),
          ),
      ],
    );
  }

  Widget _buildConversation({required bool mobile}) {
    if (!_hasSelection) {
      return const Center(
        child: Text('Selecciona un chat para iniciar.'),
      );
    }

    return Column(
      children: [
        if (mobile)
          Align(
            alignment: Alignment.centerLeft,
            child: IconButton(
              onPressed: () {
                setState(() {
                  _activeFriend = null;
                  _activeGroup = null;
                  _messages = const [];
                });
              },
              icon: const Icon(Icons.arrow_back_rounded),
            ),
          ),
        Expanded(
          child: _loadingMessages
              ? const Center(child: CircularProgressIndicator())
              : ListView.builder(
                  padding: const EdgeInsets.all(12),
                  itemCount: _messages.length,
                  itemBuilder: (context, index) {
                    final msg = _messages[index];
                    final mine = msg['sender_id']?.toString() == _userId;
                    final sender = msg['profiles']?['username']?.toString() ?? '';
                    return Align(
                      alignment: mine ? Alignment.centerRight : Alignment.centerLeft,
                      child: Container(
                        margin: const EdgeInsets.only(bottom: 8),
                        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                        constraints: const BoxConstraints(maxWidth: 320),
                        decoration: BoxDecoration(
                          color: mine ? const Color(0xFFDCF8C6) : Colors.white,
                          borderRadius: BorderRadius.circular(12),
                        ),
                        child: Column(
                          crossAxisAlignment:
                              mine ? CrossAxisAlignment.end : CrossAxisAlignment.start,
                          children: [
                            if (_isGroupMode && !mine && sender.isNotEmpty)
                              Text(
                                sender,
                                style: const TextStyle(
                                  fontSize: 11,
                                  fontWeight: FontWeight.w700,
                                  color: Color(0xFF128C7E),
                                ),
                              ),
                            Text(msg['content']?.toString() ?? ''),
                          ],
                        ),
                      ),
                    );
                  },
                ),
        ),
        SafeArea(
          top: false,
          child: Padding(
            padding: const EdgeInsets.fromLTRB(10, 6, 10, 10),
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _messageController,
                    textInputAction: TextInputAction.send,
                    onSubmitted: (_) => _sendMessage(),
                    decoration: const InputDecoration(
                      hintText: 'Escribe un mensaje',
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.all(Radius.circular(16)),
                      ),
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                FilledButton(
                  onPressed: _sending ? null : _sendMessage,
                  child: _sending
                      ? const SizedBox(
                          width: 18,
                          height: 18,
                          child: CircularProgressIndicator(strokeWidth: 2),
                        )
                      : const Icon(Icons.send_rounded),
                ),
              ],
            ),
          ),
        ),
      ],
    );
  }
}

