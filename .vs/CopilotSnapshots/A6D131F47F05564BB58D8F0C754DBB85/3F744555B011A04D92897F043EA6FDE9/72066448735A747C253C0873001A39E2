class NativeLoginPage extends StatefulWidget {
  const NativeLoginPage({super.key});

  @override
  State<NativeLoginPage> createState() => _NativeLoginPageState();
}

class _NativeLoginPageState extends State<NativeLoginPage> {
  final _userController = TextEditingController();
  final _passwordController = TextEditingController();
  bool _isSubmitting = false;
  String? _errorText;

  @override
  void dispose() {
    _userController.dispose();
    _passwordController.dispose();
    super.dispose();
  }

  Future<void> _submit() async {
    FocusScope.of(context).unfocus();
    final username = _userController.text.trim();
    final password = _passwordController.text;

    if (username.isEmpty || password.isEmpty) {
      setState(() => _errorText = 'Completa usuario y contraseña.');
      return;
    }

    setState(() {
      _isSubmitting = true;
      _errorText = null;
    });

    try {
      final valid = await _validateCredentials(username, password);
      if (!mounted) return;

      if (!valid) {
        setState(() => _errorText = 'Usuario o contraseña incorrectos.');
        return;
      }

      await Navigator.of(context).push(
        MaterialPageRoute<void>(
          builder: (_) => NativeUpdatesPage(
            username: username,
            password: password,
          ),
        ),
      );
    } catch (_) {
      if (!mounted) return;
      setState(() => _errorText = 'No se pudo conectar con ChattyFriends.');
    } finally {
      if (mounted) {
        setState(() => _isSubmitting = false);
      }
    }
  }

  Future<bool> _validateCredentials(String username, String password) async {
    final uri = Uri.parse('${_ChattyConfig.supabaseUrl}/rest/v1/profiles').replace(
      queryParameters: {
        'select': 'id',
        'username': 'eq.$username',
        'clave': 'eq.$password',
        'limit': '1',
      },
    );

    final response = await http.get(
      uri,
      headers: {
        'apikey': _ChattyConfig.supabaseAnon,
        'Authorization': 'Bearer ${_ChattyConfig.supabaseAnon}',
        'Accept': 'application/json',
      },
    );

    if (response.statusCode != 200) {
      throw Exception('Auth error ${response.statusCode}');
    }

    final decoded = jsonDecode(response.body);
    return decoded is List && decoded.isNotEmpty;
  }

