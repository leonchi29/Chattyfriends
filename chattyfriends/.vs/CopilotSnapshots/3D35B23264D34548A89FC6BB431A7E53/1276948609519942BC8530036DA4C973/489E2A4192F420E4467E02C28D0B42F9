  async function handleGoogleCallback() {
    var urlParams = new URLSearchParams(window.location.search);
    var isLinking = urlParams.get('link') === 'true';
    
    try {
      var { data: { session }, error } = await sb.auth.getSession();
      if (error || !session) return;
      
      var googleId = session.user.id;
      var googleEmail = session.user.email;
      
      if (isLinking) {
        // Vincular Google a cuenta existente
        var linkingUserId = localStorage.getItem('linking_user_id');
        if (linkingUserId) {
          var { data: profile } = await sb.from('profiles').select('*').eq('id', linkingUserId).single();
          if (profile) {
            await sb.from('profiles').update({ google_id: googleId }).eq('id', linkingUserId);
            currentUser = { ...profile, google_id: googleId };
            localStorage.setItem('chatty_user', JSON.stringify(currentUser));
            localStorage.setItem('google_link_asked_' + linkingUserId, 'true');
            localStorage.removeItem('linking_user_id');
            await sb.auth.signOut();
            window.history.replaceState({}, document.title, window.location.pathname);
            toast('Cuenta vinculada con Google', 'success');
            closeLinkGoogleModal();
            return;
          }
        }
      } else {
        // Login directo con Google
        var { data: profile } = await sb.from('profiles').select('*').eq('google_id', googleId).single();
        
        if (profile) {
          // Usuario existente con Google
          currentUser = profile;
          localStorage.setItem('chatty_user', JSON.stringify(currentUser));
          await sb.auth.signOut();
          startApp();
        } else {
          // Nuevo usuario de Google - crear perfil
          var username = googleEmail.split('@')[0];
          var { data: existing } = await sb.from('profiles').select('username').eq('username', username).single();
          if (existing) { username = username + Math.floor(Math.random() * 9999); }
          
          var { data: newProfile, error: insertError } = await sb.from('profiles').insert({
            username: username,
            clave: '',
            google_id: googleId
          }).select().single();
          
          if (insertError || !newProfile) {
            toast('Error al crear perfil');
            await sb.auth.signOut();
            return;
          }
          
          currentUser = newProfile;
          localStorage.setItem('chatty_user', JSON.stringify(currentUser));
          localStorage.setItem('google_link_asked_' + newProfile.id, 'true');
          await sb.auth.signOut();
          toast('Bienvenido ' + username, 'success');
          startApp();
        }
      }
      
      window.history.replaceState({}, document.title, window.location.pathname);
    } catch(e) {
      console.error(e);
      toast('Error en autenticaci\u00F3n con Google');
    }
  }

