  async function linkGoogleAccount() {
    try {
      localStorage.setItem('linking_user_id', currentUser.id);
      var { error } = await sb.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + window.location.pathname + '?link=true' }
