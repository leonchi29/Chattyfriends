  // --- AMIGOS ---
  async function loadFriends() {
    var { data: rows } = await sb.from('friends').select('friend_id').eq('user_id', currentUser.id);
    var list = document.getElementById('friends-list');
    list.innerHTML = '';
    if (!rows || rows.length === 0) { list.innerHTML = '<p style="color:#aaa;font-size:13px;text-align:center">Sin amigos a\u00FAn</p>'; return; }
    var ids = rows.map(function(r) { return r.friend_id; });
    var { data: profiles } = await sb.from('profiles').select('id, username, avatar_url').in('id', ids);
    if (!profiles) return;
    // Siempre mostrar bot primero si est\u00E1 en la lista
    profiles.sort(function(a, b) { return a.id === BOT_ID ? -1 : b.id === BOT_ID ? 1 : 0; });
    profiles.forEach(function(p) {
      var isBot = p.id === BOT_ID;
      var isActive = activeFriend && activeFriend.id === p.id;
      var avatarHtml;
      if (p.avatar_url) {
        avatarHtml = '<img class="avatar-img" src="' + p.avatar_url + '" />';
      } else {
        var color = isBot ? '#9c27b0' : '#4ba3f1';
        var letter = isBot ? '\uD83E\uDD16' : p.username[0].toUpperCase();
        avatarHtml = '<div class="avatar" style="background:' + color + '">' + letter + '</div>';
      }
      var div = document.createElement('div');
      div.className = 'chat-item' + (isActive ? ' active' : '');
      div.innerHTML = avatarHtml + '<span>' + (isBot ? '\uD83E\uDD16 ' : '') + p.username + '</span>';
      div.onclick = function() { openChat(p.id, p.username); };
      list.appendChild(div);
    });
  }

  async function addFriend() {
    var name = document.getElementById('friend-input').value.trim();
    if (!name) return toast('Escribe un nombre de usuario');
    var { data: friend } = await sb.from('profiles').select('id').eq('username', name).maybeSingle();
    if (!friend) return toast('Usuario no encontrado');
    if (friend.id === currentUser.id) return toast('No puedes a\u00F1adirte a ti mismo');
    var { data: exists } = await sb.from('friends').select('id').eq('user_id', currentUser.id).eq('friend_id', friend.id).maybeSingle();
    if (exists) return toast('Ya es tu amigo');
    await sb.from('friends').insert([
      { user_id: currentUser.id, friend_id: friend.id },
      { user_id: friend.id, friend_id: currentUser.id }
    ]);
    document.getElementById('friend-input').value = '';
    toast('Amigo a\u00F1adido', 'success');
    loadFriends();
  }

  // --- GRUPOS ---
  async function loadGroups() {
    var { data: memberships } = await sb.from('group_members').select('group_id').eq('user_id', currentUser.id);
    var list = document.getElementById('groups-list');
    list.innerHTML = '';
    if (!memberships || memberships.length === 0) { list.innerHTML = '<p style="color:#aaa;font-size:13px;text-align:center">Sin grupos</p>'; return; }
    var ids = memberships.map(function(m) { return m.group_id; });
    var { data: groups } = await sb.from('groups').select('*').in('id', ids);
    if (!groups) return;
    groups.forEach(function(g) {
      var isActive = activeGroup && activeGroup.id === g.id;
      var div = document.createElement('div');
      div.className = 'chat-item' + (isActive ? ' active' : '');
      div.innerHTML = '<div class="avatar" style="background:#ff9800">' + g.name[0].toUpperCase() + '</div><span>' + g.name + '</span><small style="margin-left:auto;color:#aaa;font-size:10px">' + g.invite_code + '</small>';
      div.onclick = function() { openGroupChat(g.id, g.name, g.invite_code); };
      list.appendChild(div);
    });
  }

  async function createGroup() {
    var name = document.getElementById('group-name-input').value.trim();
    if (!name) return toast('Escribe un nombre');
    var code = Math.random().toString(36).substring(2, 8).toUpperCase();
    var { data: group, error } = await sb.from('groups').insert({ name: name, owner_id: currentUser.id, invite_code: code }).select().single();
    if (error) return toast('Error al crear grupo');
    await sb.from('group_members').insert({ group_id: group.id, user_id: currentUser.id });
    document.getElementById('group-name-input').value = '';
    toast('Grupo creado. C\u00F3digo: ' + code, 'success');
    loadGroups();
  }

  async function joinGroup() {
    var code = document.getElementById('group-code-input').value.trim().toUpperCase();
    if (!code) return toast('Escribe un c\u00F3digo');
    var { data: group } = await sb.from('groups').select('*').eq('invite_code', code).maybeSingle();
    if (!group) return toast('C\u00F3digo inv\u00E1lido');
    var { data: already } = await sb.from('group_members').select('id').eq('group_id', group.id).eq('user_id', currentUser.id).maybeSingle();
    if (already) return toast('Ya est\u00E1s en este grupo');
    await sb.from('group_members').insert({ group_id: group.id, user_id: currentUser.id });
    document.getElementById('group-code-input').value = '';
    toast('Te uniste a ' + group.name, 'success');
    loadGroups();
  }

  // --- LOGICA DE CARGA Y CHAT ---
  async function openChat(id, name) {
    activeFriend = { id, name }; activeGroup = null; chatMode = 'private';
    document.getElementById('chat-title').textContent = "Chat con " + name;
    await loadMessages();
    loadFriends();
  }

  async function openGroupChat(id, name, code) {
    activeGroup = { id, name, code }; activeFriend = null; chatMode = 'group';
    document.getElementById('chat-title').textContent = "Grupo: " + name;
    await loadGroupMessages();
    loadGroups();
  }

  async function loadMessages() {
    const { data } = await sb.from('messages').select('*')
      .or(`and(sender_id.eq.${currentUser.id},receiver_id.eq.${activeFriend.id}),and(sender_id.eq.${activeFriend.id},receiver_id.eq.${currentUser.id})`)
      .order('created_at', { ascending: true });
    render(data || []);
  }

  async function loadGroupMessages() {
    const { data } = await sb.from('group_messages').select('*, profiles(username)')
      .eq('group_id', activeGroup.id).order('created_at', { ascending: true });
    render(data || [], true);
  }

  function render(msgs, isGroup = false) {
    const c = document.getElementById('chat-messages');
    c.innerHTML = '';
    msgs.forEach(m => {
      const isMe = m.sender_id === currentUser.id;
      const div = document.createElement('div');
      div.className = 'msg ' + (isMe ? 'sent' : 'received');
      const sender = (!isMe && isGroup) ? '<b style="font-size:10px">' + (m.profiles?.username || '?') + '</b><br>' : '';
      var body;
      if (m.content && m.content.indexOf('<<FILE>>') === 0) {
        body = renderFileContent(m.content, isMe);
      } else {
        body = m.content;
      }
      div.innerHTML = sender + body;
      c.appendChild(div);
    });
    c.scrollTop = c.scrollHeight;
  }

  async function sendMessage() {
    const i = document.getElementById('msg-input');
    const val = i.value.trim(); if(!val) return;
    if(chatMode === 'private') {
      await sb.from('messages').insert({ sender_id: currentUser.id, receiver_id: activeFriend.id, content: val });
      i.value = '';
      await loadMessages();
      if (activeFriend.id === BOT_ID) getBotReply(val);
    } else {
      await sb.from('group_messages').insert({ group_id: activeGroup.id, sender_id: currentUser.id, content: val });
      i.value = '';
      loadGroupMessages();
    }
  }

  async function sendFile(input) {
    var file = input.files[0];
    if (!file) return;
    if (file.size > 50 * 1024 * 1024) { toast('El archivo es muy grande (m\u00E1x 50MB)'); input.value = ''; return; }
    if (!chatMode) { toast('Selecciona un chat primero'); input.value = ''; return; }
    var ts = Date.now();
    var safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
    var path = currentUser.id + '/' + ts + '_' + safeName;
    toast('Subiendo archivo...', 'success');
    var { error } = await sb.storage.from('chat-files').upload(path, file);
    if (error) { toast('Error al subir: ' + error.message); input.value = ''; return; }
    var { data: urlData } = sb.storage.from('chat-files').getPublicUrl(path);
    var url = urlData.publicUrl;
    var meta = JSON.stringify({ url: url, name: file.name, type: file.type, size: file.size });
    var content = '<<FILE>>' + meta + '<<FILE>>';
    if (chatMode === 'private') {
      await sb.from('messages').insert({ sender_id: currentUser.id, receiver_id: activeFriend.id, content: content });
      await loadMessages();
    } else {
      await sb.from('group_messages').insert({ group_id: activeGroup.id, sender_id: currentUser.id, content: content });
      loadGroupMessages();
    }
    input.value = '';
    toast('Archivo enviado', 'success');
  }

  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function renderFileContent(content, isSent) {
    try {
      var json = content.replace(/<<FILE>>/g, '');
      var f = JSON.parse(json);
      var t = f.type || '';
      if (t.startsWith('image/')) {
        return '<img class="file-img" src="' + f.url + '" alt="' + f.name + '" onclick="window.open(this.src)" />';
      }
      if (t.startsWith('video/')) {
        return '<video controls class="file-img" src="' + f.url + '" onclick="window.open(this.src)"></video>';
      }
      if (t.startsWith('audio/')) {
        return '<audio controls class="file-img" src="' + f.url + '" onclick="window.open(this.src)"></audio>';
      }
      var icon = '/static/file-icon.png';
      return '<a href="' + f.url + '" class="file-card" download="' + f.name + '" onclick="event.stopPropagation()">' +
        '<div class="file-icon"><img src="' + icon + '" /></div>' +
        '<div class="file-info">' +
        '<div class="file-name">' + f.name + '</div>' +
        '<div class="file-size">' + formatSize(f.size) + '</div>' +
        '</div></a>';
    } catch(e) {
      return content;
    }
  }

  // --- REALTIME ---
  function subscribeRealtime() {
    const channel = sb.channel('public:messages')
      .on('INSERT', payload => {
        if (payload.new.sender_id !== currentUser.id) loadMessages();
      })
      .subscribe();
    const groupChannel = sb.channel('public:group_messages')
      .on('INSERT', payload => {
        if (payload.new.sender_id !== currentUser.id) loadGroupMessages();
      })
      .subscribe();
    console.log('Realtime channels subscribed');
  }

  function logout() { localStorage.clear(); location.reload(); }
</script>

